# ─────────────────────────────────────────────
# App URL (used for OAuth redirect)
# ─────────────────────────────────────────────
# Local dev
# VITE_APP_URL=http://localhost:3000
# Production
VITE_APP_URL=https://vuthanhdatdev.github.io

# ─────────────────────────────────────────────
# Portfolio data source
# ─────────────────────────────────────────────
# Raw URL to your data.json file (e.g. from a public GitHub repo)
VITE_PORTFOLIO_DATA_URL=https://raw.githubusercontent.com/your-username/your-repo/main/data.json

# ─────────────────────────────────────────────
# Supabase (https://supabase.com/dashboard/project/_/settings/api)
# ─────────────────────────────────────────────
# Project URL  →  Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key  →  Settings > API > Project API keys > anon public
# ⚠️  NEVER use the service_role / secret key here
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────
# GitHub blog repo (source of markdown posts)
# ─────────────────────────────────────────────
# GitHub username / org that owns the blog repo
VITE_GITHUB_OWNER=joe-the-dev

# Repo name that holds the markdown post files
VITE_GITHUB_REPO=blog-markdown-public

# Path inside the repo where .md post files live (default: posts)
VITE_GITHUB_POSTS_PATH=posts
